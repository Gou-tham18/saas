{
  "name": "saas-subscription-platform",
  "version": "1.0.0",
  "description": "AI-enabled SaaS subscription & analytics backend: Stripe test-mode checkout, PostgreSQL, Redis cache + BullMQ, cron reminders, invoices, email and an MCP server.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch-path=src src/worker.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "mcp": "node src/mcp/server.js",
    "job:expiry": "node src/jobs/runExpiryScan.js",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "bullmq": "^6.3.8",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
