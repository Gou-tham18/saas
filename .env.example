# Copy to .env and fill in. Everything here works on free tiers / local services only.

# --- App ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Infrastructure (matches docker-compose.yml) ---------------------------
DATABASE_URL=postgres://saas:saas@localhost:5432/saas
REDIS_URL=redis://localhost:6379

# --- Stripe (TEST MODE ONLY) ----------------------------------------------
# 1. Create a free account at https://dashboard.stripe.com/register (no business details needed for test mode).
# 2. Make sure "Test mode" is on, then copy the secret key from Developers -> API keys.
# 3. Install the Stripe CLI, run `stripe login` (choose the sandbox, not the live account), then
#    stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,invoice.paid,customer.subscription.updated,customer.subscription.deleted --forward-to localhost:3000/api/webhooks/stripe
#    and paste the printed signing secret (whsec_...) below.
# Leave blank to run without Stripe and use POST /api/dev/simulate-payment instead.
STRIPE_SECRET_KEY=
# e.g. STRIPE_SECRET_KEY=sk_test_51Abc...
STRIPE_WEBHOOK_SECRET=
# e.g. STRIPE_WEBHOOK_SECRET=whsec_...
# Optional overrides for the Checkout redirect pages.
# CHECKOUT_SUCCESS_URL=http://localhost:3000/api/checkout/success?session_id={CHECKOUT_SESSION_ID}
# CHECKOUT_CANCEL_URL=http://localhost:3000/api/checkout/cancel

# --- Email -------------------------------------------------------------
# Option A (zero setup): leave SMTP_HOST empty. A disposable Ethereal inbox is
#   created automatically and every sent email logs a preview URL.
# Option B (Mailtrap): sign up free at https://mailtrap.io, open
#   Email Testing -> Inboxes -> your inbox -> SMTP Settings, and copy the credentials.
SMTP_HOST=
# SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SaaS Platform <billing@saas.local>"
ATTACH_INVOICE_TO_EMAIL=true

# --- Invoices ------------------------------------------------------------
INVOICE_STORAGE_DIR=storage/invoices
# pdf | txt
INVOICE_FORMAT=pdf

# --- Scheduling & caching -------------------------------------------------
# Standard cron syntax; default = every hour on the hour. Use */1 * * * * for demos.
EXPIRY_SCAN_CRON=0 * * * *
REMINDER_DAYS_BEFORE_EXPIRY=3
CRON_TIMEZONE=UTC
METRICS_CACHE_TTL_SECONDS=60

# --- Security ------------------------------------------------------------
# /api/dev/* helpers (simulated payments, manual cron trigger). Must be false in production.
ENABLE_DEV_ROUTES=true
# If set, /api/admin/* requires header `x-api-key: <value>`.
ADMIN_API_KEY=
